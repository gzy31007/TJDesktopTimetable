<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinUI 3 外壳（**只在 Windows 上能编译**）。

    刻意与 dotnet/TjtTimetable.slnx 分开：那个解决方案是平台无关的（net10.0），
    Linux/CI 都能 `dotnet test`；把本工程加进去会让 Linux 上的构建整片失败。
    能在 Linux 上验证的部分已经全部沉到 `Tjt.Widget`，这里只剩窗口与 Win32 胶水。

    关键属性：
    - `WindowsPackageType None`：非打包（unpackaged）应用，由 WASDK 的 auto-initializer
      在生成的 Main 里定位并加载 Windows App Runtime，不需要 MSIX / 自签名证书；
    - `UseWinUI true`：XAML 编译器 + WinUI 引用；
    - `RuntimeIdentifier win-x64`：WinUI 原生资产按 RID 解析；
    - 不设 `WindowsAppSDKSelfContained`（框架依赖）：CI runner 与用户机器都装了
      Windows App Runtime；要免安装分发时再开自包含。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Tjt.App</RootNamespace>
    <AssemblyName>Tjt.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      exe 的图标（PE 资源）：资源管理器 / 任务管理器 / "固定到任务栏"读的是它。
      **窗口自身的图标不靠它** —— WinUI 3 的窗口类不带图标，不显式 `AppWindow.SetIcon`
      就回落到系统默认图标（登录窗口实测如此），那份在 Rendering/WindowIcon.cs，两件缺一不可。
      只在 Windows 上设：Linux 侧那次 EnableWindowsTargeting 编译级检查用不到资源编译器。
    -->
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 只支持 x64（与 RuntimeIdentifier 一致），显式声明以免 CI 上出现"未指定平台"歧义 -->
    <PlatformTarget>x64</PlatformTarget>
    <!--
      允许在 Linux 上"交叉编译"这个 Windows 目标：本机（WSL）没有 Windows 时也能拿到
      编译级反馈（C# 类型/签名错误一次就暴露，不必推 CI）。
      注意它**不能**完成构建 —— XAML 编译器依赖 Windows 原生的 GenXbf.dll，
      到那一步会报 WMC0621；XAML 与真机行为只能靠 Windows 侧构建（.tools/build-winui.ps1）。
    -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <!--
      LibraryImportAttribute（源生成 P/Invoke）生成的代码带指针，必须开 unsafe。
      不开会得到 SYSLIB1062 —— CI 上实测的错误。
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 固定精确版本：与 Windows App SDK 1.8 稳定线对齐（2.x 尚未用于本项目） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TjtCore\TjtCore.csproj" />
    <ProjectReference Include="..\Tjt.Widget\Tjt.Widget.csproj" />
  </ItemGroup>

  <!--
    脱敏黄金数据：**直接复用 TS 侧那一份**（单一真源），启动时读它当作"当前课表"，
    找不到时退回内置样例（见 DemoData.cs）。`Link` + CopyToOutputDirectory 的用法与
    TjtCore.Tests 一致，避免依赖运行时的工作目录。
  -->
  <!-- 图标：都从输出目录**运行时**加载（不嵌资源，改图标不用改代码）
       - app.ico      白色版：托盘菜单与 SendTo/资源管理器看到的 exe 图标（ApplicationIcon）
       - app-blue.ico 课表同款蓝（#4CC2FF）：**窗口**图标（标题栏 / 任务栏 / Alt-Tab），
                      白色版在浅色系统标题栏上看不清，见 Rendering/WindowIcon.cs -->
  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app-blue.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\tongji-2026-1-personal.json"
             Link="fixtures\tongji-2026-1-personal.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    `dotnet publish` 会漏掉 XAML 编译产物与资源索引（2026-09-16 实测）：

      build 输出里有  App.xbf / MainWindow.xbf / SettingsWindow.xbf / Tjt.App.pri
      publish 输出里**没有**（WinUI 的 targets 只把它们放进 build 输出）

    而 `MainWindow.InitializeComponent()` → `LoadComponent("ms-appx:///MainWindow.xaml")` 正是靠这几件
    解析 XAML —— 缺了就直接抛 `XamlParseException: XAML parsing failed`，表现为"自包含发布出来的 exe
    一启动就退出"（`.tools/release-preflight.ps1` 抓到的就是这个）。所以显式补一份：
    不补的话，Release 资产会变成"能下载、不能运行"。
  -->
  <Target Name="CopyXamlArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <XamlPublishArtifact Include="$(TargetDir)*.xbf" />
      <XamlPublishArtifact Include="$(TargetDir)Tjt.App.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlPublishArtifact)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
