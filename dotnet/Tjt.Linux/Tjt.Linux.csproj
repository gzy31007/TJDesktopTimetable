<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux 外壳（Avalonia）：窗口 / 渲染 / X11 贴桌面层 / 导入编排。

    与 Tjt.App（WinUI 外壳，只在 Windows 上编译）平行的另一条壳：
    - 业务逻辑全部来自 TjtCore（平台无关），视觉计算全部来自 Tjt.Widget（纯函数）；
    - 本工程只做"必须在 Linux 桌面上跑"的事：Avalonia 窗口、X11 层级、文件与网络 IO；
    - 刻意不并进 dotnet/TjtTimetable.slnx（那是平台无关的测试解决方案，结构保持与上游一致），
      用 dotnet/TjtTimetable.Linux.slnx 单独构建。

    数据目录：Environment.SpecialFolder.ApplicationData 在 Linux 上映射 XDG（~/.config），
    落点 ~/.config/TJDesktopTimetable/，settings.json / timetable.json / credentials.json
    与 Windows 版同构（手工互拷可用）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tjt.Linux</RootNamespace>
    <AssemblyName>Tjt.Linux</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TjtCore\TjtCore.csproj" />
    <ProjectReference Include="..\Tjt.Widget\Tjt.Widget.csproj" />
  </ItemGroup>

  <!--
    图标复用 Tjt.App 的资产（packaging/tjt-linux.desktop 安装时引用）。
    与 Tjt.App 同口径：**不**打包 dotnet/fixtures/ 的黄金数据 —— 那是真实抓包，
    只服务于测试与显式指定的 `fixture` 开关；没导入课表时显示的是虚构内置示例（Data/DemoData.cs）。
  -->
  <ItemGroup>
    <Content Include="..\Tjt.App\Assets\app-256.png"
             Link="Assets\app-256.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
