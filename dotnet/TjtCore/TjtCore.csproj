<Project Sdk="Microsoft.NET.Sdk">

  <!--
    纯逻辑核心库：**平台无关**（net10.0，不引任何 Windows/WinUI 依赖）。
    这条硬约束原样继承自 Electron 线的 TS 核心库（`packages/core`，2026-09-16 随该线一起删除）——
    这样它能在 Linux/CI 上编译和跑测试，Windows 只属于 WinUI 外壳。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Tjt.Core</RootNamespace>
    <AssemblyName>Tjt.Core</AssemblyName>
  </PropertyGroup>

</Project>
