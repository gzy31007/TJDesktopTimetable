<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tjt.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TjtCore\TjtCore.csproj" />
    <!-- 挂件视觉层（纯 net10.0）：几何/染色/文案的单测也跑在这里，Linux 上就能验证 -->
    <ProjectReference Include="..\Tjt.Widget\Tjt.Widget.csproj" />
  </ItemGroup>

  <!--
    黄金测试基准：脱敏后的真实抓包数据（`dotnet/fixtures/`，2026-09-16 从 TS 线搬过来 ——
    Electron 线已弃用，这里现在是唯一真源）。
    `Link` + `CopyToOutputDirectory` 让测试从输出目录读（AppContext.BaseDirectory/fixtures），
    避免依赖运行时的当前工作目录。
  -->
  <!--
    导入编排（dotnet/Tjt.App/Data/ImportService.cs）**链接源码**进本工程：它没有 WinUI 依赖，
    桩掉外壳静态类（见 ShellStubsForImportService.cs）就能在 Linux 上验证"应用才有成功文案"这类语义。
    链接而不是复制：副本会与出货代码立刻不同步。App 工程自己仍然单独编译这一份。
  -->
  <ItemGroup>
    <Compile Include="..\Tjt.App\Data\ImportService.cs" Link="Linked\ImportService.cs" />
    <Compile Include="..\Tjt.App\Data\UpdateCheckScheduler.cs" Link="Linked\UpdateCheckScheduler.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fixtures\*.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
