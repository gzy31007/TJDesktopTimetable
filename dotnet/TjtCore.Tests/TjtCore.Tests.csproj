<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tjt.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TjtCore\TjtCore.csproj" />
    <!-- 挂件视觉层（纯 net10.0）：几何/染色/文案的单测也跑在这里，Linux 上就能验证 -->
    <ProjectReference Include="..\Tjt.Widget\Tjt.Widget.csproj" />
  </ItemGroup>

  <!--
    黄金测试基准：脱敏后的真实抓包数据，**直接复用 TS 侧那一份**（单一真源）。
    `Link` + `CopyToOutputDirectory` 让测试从输出目录读（AppContext.BaseDirectory/fixtures），
    避免依赖运行时的当前工作目录。
  -->
  <ItemGroup>
    <Content Include="..\..\packages\core\fixtures\*.json" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
