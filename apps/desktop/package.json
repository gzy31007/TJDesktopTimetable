{
  "name": "@tjt/desktop",
  "productName": "TJDesktopTimetable",
  "version": "0.1.0",
  "private": true,
  "description": "同济桌面课表小组件（Electron + Vue 3）",
  "author": "gzy31007",
  "license": "MIT",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --x64 --dir",
    "dist:win:wsl": "electron-vite build && electron-builder --win --x64 --dir --config.electronDownload.cache=$PWD/.cache/electron",
    "dist:win:zip": "electron-vite build && electron-builder --win --x64 --dir --config.win.target=zip --config.electronDownload.cache=$PWD/.cache/electron",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@tjt/core": "workspace:*",
    "@types/node": "^24.9.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vue": "^3.5.42",
    "vue-tsc": "^3.1.1",
    "vitest": "^5.0.0"
  }
}
